<?xml version="1.0"?>
<!DOCTYPE hibernate-mapping PUBLIC
    "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
    "http://hibernate.sourceforge.net/hibernate-mapping-3.0.dtd" >

<hibernate-mapping package="org.openmrs.module.providermanagement">

	<class name="ProviderRoleRelationshipType" table="providermanagement_provider_role_relationship_type">
        <composite-id>
            <key-property name="providerRole" column="provider_role_id" type="org.openmrs.ProviderRole"/>
            <key-property name="relationshipType" column="relationship_type_id" type="org.openmrs.RelationshipType"/>
        </composite-id>
	</class>

</hibernate-mapping>
